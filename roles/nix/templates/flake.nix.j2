{
  description = "Home Manager configuration";

  inputs = {
    # Direct shallow Git inputs avoid GitHub's low unauthenticated REST API quota.
    nixpkgs.url = "git+https://github.com/NixOS/nixpkgs.git?ref={{ nixpkgs_release }}&shallow=1";
    nixpkgs-unstable.url = "git+https://github.com/NixOS/nixpkgs.git?ref=nixos-unstable&shallow=1";
    home-manager.url = "git+https://github.com/nix-community/home-manager.git?ref={{ home_manager_release }}&shallow=1";
    home-manager.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = { nixpkgs, nixpkgs-unstable, home-manager, ... }:
  let
    system = "{{ nix_system }}";
    pkgs = import nixpkgs {
      inherit system;
      config.allowUnfree = true;
    };
  in {
    # Expose the locked Home Manager package so activation reuses this flake's inputs.
    packages.${system}.home-manager = home-manager.packages.${system}.default;

    homeConfigurations."{{ host_user }}" = home-manager.lib.homeManagerConfiguration {
      inherit pkgs;
      # Only Claude Code uses unstable; other packages retain the stable package set.
      extraSpecialArgs.claude_code = (import nixpkgs-unstable {
        inherit system;
        config.allowUnfree = true;
      }).claude-code;
      modules = [ ./home.nix ];
    };
  };
}
